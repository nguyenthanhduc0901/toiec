{
  "name": "toiec-studio",
  "version": "1.2.0",
  "private": true,
  "description": "TOEIC practice: 50 tests, 10,000 questions, combined Parts, shared progress and persistent mistake history.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "test:study-progress": "node --test scripts/study-progress.test.mjs",
    "test:audio-cache": "node --test scripts/audio-cache.test.mjs"
  }
}
