{
  "name": "toiec-studio",
  "version": "1.2.0",
  "private": true,
  "description": "Local TOEIC practice: ETS 2023, 2024 and 2026, 30 tests and 6,000 questions with separate progress per year.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "check": "node scripts/check.mjs",
    "start": "node scripts/serve.mjs",
    "test:audio-cache": "node --test scripts/audio-cache.test.mjs"
  }
}
